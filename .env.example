# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit it.

# BigQuery project and target dataset
DBT_BQ_PROJECT=olist-analytics-498115
DBT_BQ_DATASET=dev          # use "ci" in GitHub Actions

# Absolute path to your GCP service-account JSON key (git-ignored)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/olist-sa-key.json
